# ----------------------------------------------------------------------
# MemeStack frontend — environment variables
# For Vercel, set the Production value to the backend's Vercel URL.
# For local dev, either leave the default (localhost) or point at a
# running backend.
# ----------------------------------------------------------------------

# Base URL of the backend API (include the /api suffix).
# Example: https://memestack-api.vercel.app/api
REACT_APP_API_URL=http://localhost:5000/api

# Branding
REACT_APP_NAME=MemeStack
REACT_APP_VERSION=1.1.0

# CRA build options
GENERATE_SOURCEMAP=false
FAST_REFRESH=true
