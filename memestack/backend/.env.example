# ----------------------------------------------------------------------
# MemeStack backend — required environment variables
# Copy this file to .env (for local dev) and configure the Vercel
# project with the same keys for production.
# ----------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database — for production, set this to your MongoDB Atlas URI.
# If omitted in development, an in-memory Mongo is used (data resets on
# restart). Omitting it in production will cause the server to refuse to
# start.
MONGODB_URI=

# Auth — generate a random 32+ character string:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS — comma-separated list of origins allowed to call the API.
# In production set this to your frontend Vercel URL.
CLIENT_URL=http://localhost:3000

# Cloudinary (required in production for image uploads).
# Without these, uploads fall back to local disk which is NOT persistent
# on Vercel. Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — absolute base URL for local-disk upload fallbacks.
# Only used in dev; ignored when CLOUDINARY_* are set.
# BASE_URL=http://localhost:5000

# Optional — controls express file size limit & rate limiting in future
MAX_FILE_SIZE=10485760
